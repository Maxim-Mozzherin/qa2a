# ==============================================================================
# QA2A Environment Configuration Template (.env.example)
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASS=your_secure_db_password
DB_NAME=qa2a

# Port mapping for Docker Compose dev setup (defaults to 5434 to avoid 5432/5433 collisions)
DEV_DB_PORT=5434

# ------------------------------------------------------------------------------
# 2. APPLICATION PORTS
# ------------------------------------------------------------------------------
QA2A_PORT=8082
PARSER_PORT=8099

# ------------------------------------------------------------------------------
# 3. SECURITY & CRYPTOGRAPHY
# ------------------------------------------------------------------------------
# 32+ character hex or base64 key for AES-256-GCM encryption of iiko passwords
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Internal API authentication key for inter-service communication
EXTERNAL_API_KEY=your_internal_external_api_key_secret

# Master token for superadmin access to marketplace analytics
SUPERADMIN_TOKEN=your_superadmin_secret_token

# ------------------------------------------------------------------------------
# 4. TELEGRAM BOT
# ------------------------------------------------------------------------------
BOT_TOKEN=123456789:ABCDEF_YourTelegramBotTokenHere
ADMIN_TG_ID=123456789

# ------------------------------------------------------------------------------
# 5. AI / LLM INVOICE PARSER (Gemini Vision)
# ------------------------------------------------------------------------------
AI_API_KEY=your_gemini_or_openrouter_api_key
AI_BASE_URL=http://127.0.0.1:20128/v1/chat/completions
AI_MODEL=gemini/gemini-3.5-flash,gemini/gemini-3.0-flash

# Base URL of QA2A backend for parser callbacks
QA2A_URL=http://localhost:8082
